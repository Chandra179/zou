{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zou business-rule file",
  "description": "Shape only. Cross-field rules and the coverage report are in scripts/check_rules.py.",
  "type": "object",
  "required": ["app", "rules"],
  "additionalProperties": false,
  "properties": {
    "app": { "type": "string", "minLength": 1 },
    "state": { "enum": ["idea", "specified", "built"], "description": "Where the app was when this file was started." },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "statement", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "statement": { "type": "string", "minLength": 1, "description": "Plain language; EARS wording (WHEN ... THE SYSTEM SHALL ...) is optional." },
        "status": { "enum": ["confirmed", "proposed", "open"], "description": "confirmed = a decision maker decided it; proposed = inferred, awaiting decision; open = unresolved question." },
        "rationale": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["stakeholder", "document", "code", "incident", "inferred"] },
            "ref": { "type": "string" }
          }
        },
        "decided_by": { "type": "string" },
        "decided_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" } },
        "check": {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["test", "assertion", "review", "proof", "measurement", "none"] },
            "ref": { "type": "string" },
            "strength": { "enum": ["exhaustive", "bounded", "sampled", "human"], "description": "How far the check's conclusion reaches." }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["result"],
          "additionalProperties": false,
          "properties": {
            "result": { "enum": ["verified", "violated", "unknown", "out_of_scope"] },
            "ref": { "type": "string" },
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "limitations": { "type": "string" }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["kind", "name", "given", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["required", "forbidden", "exceptional"], "description": "required = must work; forbidden = must be rejected or impossible; exceptional = edge or failure case." },
        "name": { "type": "string", "minLength": 1 },
        "given": { "type": "string" },
        "when": { "type": "string" },
        "then": { "type": "string" }
      }
    }
  }
}
